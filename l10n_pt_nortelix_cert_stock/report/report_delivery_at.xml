<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estende o MESMO layout partilhado que l10n_pt_nortelix_cert já usa para
         faturas/recibos (external_layout_standard_at) — QR Code + ATCUD no canto superior
         direito e o rodapé legal (caracteres de controlo + nº de certificado), agora
         também para stock.picking. Só cobre o tema "Standard" (ver nota equivalente no
         módulo base) — replicar no template do tema em uso se a empresa usar outro. -->
    <template id="external_layout_standard_at_stock"
              inherit_id="l10n_pt_nortelix_cert.external_layout_standard_at">
        <!-- Tamanho em px, não cm/mm: ver comentário equivalente em
             l10n_pt_nortelix_cert/report/report_invoice_at.xml — o wkhtmltopdf não
             redimensiona <img> de forma fiável por unidades físicas CSS. -->
        <xpath expr="//img[hasclass('o_company_logo_small')]" position="after">
            <div class="text-center"
                 style="position:absolute; top:0; right:0; width:150px;"
                 t-if="o and o._name == 'stock.picking' and o.l10n_pt_nortelix_qr_code_url">
                <img t-att-src="o.l10n_pt_nortelix_qr_code_url" style="width:140px;height:140px;"/>
                <div class="small mt-1" style="white-space:nowrap; font-size:9px;">
                    <strong>ATCUD:</strong> <span t-field="o.l10n_pt_nortelix_atcud"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_content')]" position="after">
            <div class="text-muted small text-center"
                 t-if="o and o._name == 'stock.picking' and o.l10n_pt_nortelix_hash_control">
                <span t-field="o.l10n_pt_nortelix_hash_control"/>-Processado por programa certificado n.º
                <span t-out="o.company_id.l10n_pt_nortelix_certificate_number or '0'"/>/AT
            </div>
        </xpath>
        <xpath expr="//t[@t-call='web.address_layout']" position="before">
            <div t-if="o and o._name == 'stock.picking' and o.company_id.l10n_pt_nortelix_environment == 'test'"
                 style="position:fixed; top:45%; left:0; width:100%; text-align:center;
                        transform:rotate(-30deg); font-size:34px; font-weight:bold;
                        color:rgba(255,0,0,0.35); z-index:1000;">
                Documento emitido para fins de formação
            </div>
        </xpath>
    </template>

    <!-- Título correto ("Guia de Transporte", não "Nota de Entrega"/"Delivery Note") e
         aviso bem visível a vermelho quando a guia ainda não foi comunicada à AT — só
         para guias que de facto passaram pelo fluxo de certificação (têm ATCUD); uma
         transferência interna sem série configurada continua a mostrar o título e
         comportamento normais da Odoo. -->
    <template id="report_delivery_document_at" inherit_id="stock.report_delivery_document">
        <xpath expr="//h2[@style='margin-top: 15px;']/span[1]" position="replace">
            <span t-if="o.l10n_pt_nortelix_atcud">Guia de Transporte</span>
            <span t-else="" t-out="o.picking_type_id._get_code_report_name()"/>
        </xpath>
        <xpath expr="//h2[@style='margin-top: 15px;']" position="after">
            <div t-if="o.l10n_pt_nortelix_atcud and o.l10n_pt_nortelix_dt_status != 'sent'"
                 style="color:#b3352f; font-weight:bold; border:1px solid #b3352f;
                        padding:4px 10px; margin-bottom:10px; display:inline-block;">
                Documento não comunicado à Autoridade Tributária
            </div>
        </xpath>
    </template>
</odoo>
