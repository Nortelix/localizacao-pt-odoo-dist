<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="series_type_ft" model="l10n_pt_nortelix.series.type">
        <field name="code">FT</field>
        <field name="name">Fatura</field>
        <field name="applies_to_model">account.move</field>
    </record>
    <record id="series_type_fs" model="l10n_pt_nortelix.series.type">
        <field name="code">FS</field>
        <field name="name">Fatura Simplificada</field>
        <field name="applies_to_model">account.move</field>
    </record>
    <record id="series_type_fr" model="l10n_pt_nortelix.series.type">
        <field name="code">FR</field>
        <field name="name">Fatura-Recibo</field>
        <field name="applies_to_model">account.move</field>
    </record>
    <record id="series_type_nc" model="l10n_pt_nortelix.series.type">
        <field name="code">NC</field>
        <field name="name">Nota de Crédito</field>
        <field name="applies_to_model">account.move</field>
    </record>
    <record id="series_type_nd" model="l10n_pt_nortelix.series.type">
        <field name="code">ND</field>
        <field name="name">Nota de Débito</field>
        <field name="applies_to_model">account.move</field>
    </record>
    <record id="series_type_gt" model="l10n_pt_nortelix.series.type">
        <field name="code">GT</field>
        <field name="name">Guia de Transporte</field>
        <field name="applies_to_model">stock.picking</field>
    </record>
    <record id="series_type_gr" model="l10n_pt_nortelix.series.type">
        <field name="code">GR</field>
        <field name="name">Guia de Remessa</field>
        <field name="applies_to_model">stock.picking</field>
    </record>
    <!-- "RC" (regime de IVA de caixa) e "RG" (regime normal) são os dois tipos de recibo
         previstos no PaymentType do SAF-T (PT) — confirmado contra a documentação da AT.
         Este módulo só implementa o regime normal (RG); RC fica definido para o dia em
         que o regime de IVA de caixa for suportado. applies_to_model="account.payment"
         nos dois, porque um recibo aplica-se ao pagamento, não à fatura. -->
    <record id="series_type_rc" model="l10n_pt_nortelix.series.type">
        <field name="code">RC</field>
        <field name="name">Recibo (regime de IVA de caixa)</field>
        <field name="applies_to_model">account.payment</field>
    </record>
    <record id="series_type_rg" model="l10n_pt_nortelix.series.type">
        <field name="code">RG</field>
        <field name="name">Recibo</field>
        <field name="applies_to_model">account.payment</field>
    </record>
</odoo>
