<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- l10n_pt_nortelix.series -->
    <record id="view_l10n_pt_nortelix_series_list" model="ir.ui.view">
        <field name="name">l10n_pt_nortelix.series.list</field>
        <field name="model">l10n_pt_nortelix.series</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="series_type_id"/>
                <field name="year"/>
                <field name="state" widget="badge"/>
                <field name="validation_code"/>
                <field name="last_sequence_number"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_pt_nortelix_series_form" model="ir.ui.view">
        <field name="name">l10n_pt_nortelix.series.form</field>
        <field name="model">l10n_pt_nortelix.series</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_at_series_communicate_wizard)d" type="action"
                            string="Comunicar à AT"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_activate" type="object" string="Ativar"
                            class="oe_highlight" invisible="state != 'communicated'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'communicated')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,communicated,active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="series_type_id"/>
                            <field name="journal_id"/>
                            <field name="year"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="validation_code"/>
                            <field name="communication_date"/>
                            <field name="last_sequence_number"/>
                            <field name="last_document_hash"/>
                        </group>
                    </group>
                    <group string="Resposta da AT">
                        <field name="at_response_raw" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_pt_nortelix_series_search" model="ir.ui.view">
        <field name="name">l10n_pt_nortelix.series.search</field>
        <field name="model">l10n_pt_nortelix.series</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="series_type_id"/>
                <field name="year"/>
                <filter name="filter_draft" string="Rascunho" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_communicated" string="Comunicada"
                        domain="[('state', '=', 'communicated')]"/>
                <filter name="filter_active" string="Ativa" domain="[('state', '=', 'active')]"/>
                <separator/>
                <group>
                    <filter name="group_by_year" string="Ano" context="{'group_by': 'year'}"/>
                    <filter name="group_by_type" string="Tipo de Documento"
                            context="{'group_by': 'series_type_id'}"/>
                    <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_by_journal" string="Diário"
                            context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_pt_nortelix_series" model="ir.actions.act_window">
        <field name="name">Séries AT</field>
        <field name="res_model">l10n_pt_nortelix.series</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_pt_nortelix_series_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cria a primeira série documental AT
            </p>
            <p>
                Cada tipo de documento (Fatura, Nota de Crédito, ...) precisa de uma série
                por ano civil, comunicada à AT antes de poder emitir documentos.
            </p>
        </field>
    </record>

    <!-- l10n_pt_nortelix.series.type -->
    <record id="view_l10n_pt_nortelix_series_type_list" model="ir.ui.view">
        <field name="name">l10n_pt_nortelix.series.type.list</field>
        <field name="model">l10n_pt_nortelix.series.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="applies_to_model"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_l10n_pt_nortelix_series_type" model="ir.actions.act_window">
        <field name="name">Tipos de Documento AT</field>
        <field name="res_model">l10n_pt_nortelix.series.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_l10n_pt_nortelix_root" name="Certificação AT"
              groups="l10n_pt_nortelix_cert.group_l10n_pt_nortelix_at_user"
              sequence="90"/>
    <menuitem id="menu_l10n_pt_nortelix_series" name="Séries AT"
              parent="menu_l10n_pt_nortelix_root"
              action="action_l10n_pt_nortelix_series" sequence="10"/>
    <menuitem id="menu_l10n_pt_nortelix_series_type" name="Tipos de Documento"
              parent="menu_l10n_pt_nortelix_root"
              action="action_l10n_pt_nortelix_series_type"
              groups="l10n_pt_nortelix_cert.group_l10n_pt_nortelix_at_manager"
              sequence="20"/>
</odoo>
