<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_l10n_pt_nortelix" model="ir.ui.view">
        <field name="name">res.company.form.l10n_pt_nortelix</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Certificação Fiscal AT" name="l10n_pt_nortelix_at">
                    <button name="%(action_at_company_setup_wizard)d" type="action"
                            string="Testar Licença Nortelix" class="btn-secondary"/>
                    <group>
                        <group string="Ambiente">
                            <field name="l10n_pt_nortelix_environment" widget="radio"/>
                        </group>
                        <group string="Webservice AT (Séries)">
                            <field name="l10n_pt_nortelix_ws_wsdl_test_url"/>
                            <field name="l10n_pt_nortelix_ws_wsdl_production_url"/>
                            <field name="l10n_pt_nortelix_ws_username"/>
                            <field name="l10n_pt_nortelix_ws_password" password="True"/>
                        </group>
                    </group>
                    <group string="Licença e Assinatura Nortelix">
                        <field name="l10n_pt_nortelix_signing_service_url"/>
                        <field name="l10n_pt_nortelix_license_api_key" password="True"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
