<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_l10n_pt_nortelix" model="ir.ui.view">
        <field name="name">account.payment.form.l10n_pt_nortelix</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="oe_title" invisible="not l10n_pt_nortelix_atcud">
                    <label for="l10n_pt_nortelix_atcud" string="ATCUD"/>
                    <h3><field name="l10n_pt_nortelix_atcud"/></h3>
                </div>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="Certificação Fiscal AT" name="l10n_pt_nortelix_at">
                    <group>
                        <field name="l10n_pt_nortelix_series_id" readonly="1"/>
                        <field name="l10n_pt_nortelix_sequence_number" readonly="1"/>
                        <field name="l10n_pt_nortelix_system_entry_date" readonly="1"/>
                        <field name="l10n_pt_nortelix_hash" readonly="1"/>
                        <field name="l10n_pt_nortelix_hash_control" readonly="1"/>
                        <field name="l10n_pt_nortelix_algorithm_version" readonly="1"/>
                        <field name="l10n_pt_nortelix_qr_code_data" readonly="1"/>
                        <field name="l10n_pt_nortelix_qr_code_url" readonly="1" widget="url"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
