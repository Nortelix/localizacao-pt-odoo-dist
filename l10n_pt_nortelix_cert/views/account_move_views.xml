<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_pt_nortelix" model="ir.ui.view">
        <field name="name">account.move.form.l10n_pt_nortelix</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="oe_title" invisible="not l10n_pt_nortelix_atcud">
                    <label for="l10n_pt_nortelix_atcud" string="ATCUD"/>
                    <h3><field name="l10n_pt_nortelix_atcud"/></h3>
                </div>
                <field name="l10n_pt_nortelix_efatura_applicable" invisible="1"/>
                <field name="l10n_pt_nortelix_efatura_realtime_enabled" invisible="1"/>
                <div class="alert alert-danger" role="alert"
                     invisible="l10n_pt_nortelix_at_invoice_status != 'A'">
                    <strong>Documento ANULADO na AT</strong> em
                    <field name="l10n_pt_nortelix_at_cancel_date" readonly="1" nolabel="1"/>.
                    Motivo: <field name="l10n_pt_nortelix_at_cancel_reason" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="not l10n_pt_nortelix_hash or not l10n_pt_nortelix_efatura_applicable
                                 or l10n_pt_nortelix_efatura_status == 'sent'
                                 or not l10n_pt_nortelix_efatura_realtime_enabled">
                    <strong>Este documento ainda NÃO foi comunicado à AT (e-Fatura).</strong>
                    A comunicação em tempo real está ativa para esta série — o envio deveria
                    ter sido automático ao emitir o documento. Consulte a página
                    "Certificação Fiscal AT" e use "Reenviar ao e-Fatura".
                </div>
                <div class="alert alert-info" role="alert"
                     invisible="not l10n_pt_nortelix_hash or not l10n_pt_nortelix_efatura_applicable
                                 or l10n_pt_nortelix_efatura_status == 'sent'
                                 or l10n_pt_nortelix_efatura_realtime_enabled">
                    <strong>Este documento não foi comunicado à AT (e-Fatura).</strong>
                    A comunicação automática em tempo real está desativada para a série deste
                    documento — envie manualmente na página "Certificação Fiscal AT", se
                    aplicável.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Certificação Fiscal AT" name="l10n_pt_nortelix_at">
                    <group>
                        <field name="l10n_pt_nortelix_force_series_type_id"
                               readonly="l10n_pt_nortelix_hash != False"/>
                        <field name="l10n_pt_nortelix_series_id" readonly="1"/>
                        <field name="l10n_pt_nortelix_sequence_number" readonly="1"/>
                        <field name="l10n_pt_nortelix_system_entry_date" readonly="1"/>
                        <field name="l10n_pt_nortelix_hash" readonly="1"/>
                        <field name="l10n_pt_nortelix_hash_control" readonly="1"/>
                        <field name="l10n_pt_nortelix_algorithm_version" readonly="1"/>
                        <field name="l10n_pt_nortelix_qr_code_data" readonly="1"/>
                        <field name="l10n_pt_nortelix_qr_code_url" readonly="1" widget="url"/>
                    </group>
                    <group string="e-Fatura" invisible="not l10n_pt_nortelix_hash">
                        <field name="l10n_pt_nortelix_efatura_status" readonly="1"/>
                        <field name="l10n_pt_nortelix_efatura_sent_at" readonly="1"/>
                        <field name="l10n_pt_nortelix_efatura_response_code" readonly="1"/>
                        <field name="l10n_pt_nortelix_efatura_response_message" readonly="1"/>
                        <button name="action_l10n_pt_nortelix_retry_efatura" type="object"
                                string="Reenviar ao e-Fatura" class="btn-secondary"
                                invisible="l10n_pt_nortelix_efatura_status == 'sent'"/>
                    </group>
                    <!-- Um documento pode ser anulado mesmo sem nunca ter sido enviado ao
                         e-Fatura em tempo real (série com comunicação em tempo real
                         desativada, ou tipo de documento fora do âmbito do e-Fatura,
                         cliente que só usa o SAF-T mensal) — só precisa de estar
                         assinado. Ver _l10n_pt_nortelix_cancel_at_status em
                         account_move.py: só chama o webservice de anulação quando a
                         comunicação em tempo real está de facto ativa para esta série;
                         caso contrário fica só marcado localmente, refletido no
                         próximo SAF-T. -->
                    <group string="Anulação na AT" invisible="not l10n_pt_nortelix_hash">
                        <field name="l10n_pt_nortelix_at_invoice_status" readonly="1"/>
                        <field name="l10n_pt_nortelix_at_cancel_date" readonly="1"
                               invisible="l10n_pt_nortelix_at_invoice_status != 'A'"/>
                        <field name="l10n_pt_nortelix_at_cancel_reason" readonly="1"
                               invisible="l10n_pt_nortelix_at_invoice_status != 'A'"/>
                        <button name="action_l10n_pt_nortelix_open_cancel_wizard" type="object"
                                string="Anular Documento na AT" class="btn-danger"
                                invisible="l10n_pt_nortelix_at_invoice_status == 'A'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Auditoria: documentos assinados (ATCUD/hash), só consulta -->
    <record id="view_l10n_pt_nortelix_signed_documents_list" model="ir.ui.view">
        <field name="name">account.move.list.l10n_pt_nortelix.audit</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="l10n_pt_nortelix_series_id, l10n_pt_nortelix_sequence_number">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="l10n_pt_nortelix_series_id"/>
                <field name="l10n_pt_nortelix_sequence_number"/>
                <field name="l10n_pt_nortelix_atcud"/>
                <field name="l10n_pt_nortelix_hash_control"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_pt_nortelix_signed_documents_search" model="ir.ui.view">
        <field name="name">account.move.search.l10n_pt_nortelix.audit</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="l10n_pt_nortelix_atcud"/>
                <field name="l10n_pt_nortelix_series_id"/>
                <group>
                    <filter name="group_by_series" string="Série AT"
                            context="{'group_by': 'l10n_pt_nortelix_series_id'}"/>
                    <filter name="group_by_month" string="Mês" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_pt_nortelix_signed_documents" model="ir.actions.act_window">
        <field name="name">Documentos Assinados (Auditoria)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('l10n_pt_nortelix_hash', '!=', False)]</field>
        <field name="search_view_id" ref="view_l10n_pt_nortelix_signed_documents_search"/>
        <field name="context">{'search_default_group_by_series': 1}</field>
    </record>
    <record id="ir_actions_act_window_view_signed_documents_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_l10n_pt_nortelix_signed_documents_list"/>
        <field name="act_window_id" ref="action_l10n_pt_nortelix_signed_documents"/>
    </record>

    <menuitem id="menu_l10n_pt_nortelix_signed_documents"
              name="Documentos Assinados"
              parent="l10n_pt_nortelix_cert.menu_l10n_pt_nortelix_root"
              action="action_l10n_pt_nortelix_signed_documents"
              sequence="15"/>
</odoo>
