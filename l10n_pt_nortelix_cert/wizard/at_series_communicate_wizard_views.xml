<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_at_series_communicate_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt_nortelix.series.communicate.wizard.form</field>
        <field name="model">l10n_pt_nortelix.series.communicate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="series_id" invisible="1"/>
                <group>
                    <field name="mode" widget="radio"/>
                    <field name="manual_validation_code" invisible="mode != 'manual'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_at_series_communicate_wizard" model="ir.actions.act_window">
        <field name="name">Comunicar Série à AT</field>
        <field name="res_model">l10n_pt_nortelix.series.communicate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_at_company_setup_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt_nortelix.company.setup.wizard.form</field>
        <field name="model">l10n_pt_nortelix.company.setup.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id"/>
                    <field name="result_message" readonly="1" invisible="not result_message"/>
                </group>
                <footer>
                    <button name="action_test_signature" type="object"
                            string="Testar Licença" class="btn-primary"/>
                    <button string="Fechar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_at_company_setup_wizard" model="ir.actions.act_window">
        <field name="name">Testar Licença Nortelix</field>
        <field name="res_model">l10n_pt_nortelix.company.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
