<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saft_export_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pt_nortelix.saft.export.wizard.form</field>
        <field name="model">l10n_pt_nortelix.saft.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <group invisible="not file_data">
                    <field name="move_count" string="Documentos incluídos"/>
                    <field name="file_data" filename="file_name" readonly="1"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Gerar SAF-T"
                            class="btn-primary"/>
                    <button string="Fechar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_saft_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportar SAF-T (PT)</field>
        <field name="res_model">l10n_pt_nortelix.saft.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_saft_export"
              name="Exportar SAF-T"
              parent="l10n_pt_nortelix_cert.menu_l10n_pt_nortelix_root"
              action="action_saft_export_wizard"
              groups="l10n_pt_nortelix_cert.group_l10n_pt_nortelix_at_manager"
              sequence="30"/>
</odoo>
